# JSON Web Token (JWT) settings
SECRET_KEY="development_secret_key_change_me_in_production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Supabase (Required for Auth & Postgres DB)
# These are found in your Supabase Project Settings -> API
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_SERVICE_KEY="your-supabase-service-role-key"

# Ollama AI Configuration (Optional, defaults to localhost)
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_VISION_MODEL="moondream"
OLLAMA_LLM_MODEL="phi3:mini"
OLLAMA_CHAT_MODEL="phi3:mini"
OLLAMA_MINI_MODEL="qwen2.5:0.5b"

# File Uploads
MEDIA_DIR="./media/uploads"
MAX_IMAGE_SIZE_MB=10

# Environment
ENVIRONMENT="development"
